ZETARIS_BASE_URL=http://127.0.0.1:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ENGINE_ID=
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
# Leave blank to read the local Windows runtime proxy-token file.
NIGHTSHIFT_TOKEN=
NIGHTSHIFT_MODEL=meterless/local
# Local game-data Postgres (docker/gamedata.compose.yml) and the read-only user Zetaris connects with.
# At least 12 letters, digits, _ or -.
GAMEDATA_PG_PASSWORD=
# Docker network of your Zetaris deployment (docker network ls).
ZETARIS_DOCKER_NETWORK=liveops-zetaris_default
# Web app port.
APP_PORT=4317
